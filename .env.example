# Local: node --env-file=.env server.mjs (Node 22 ou 24).
# Nunca publique .env, data/ ou o valor privado de BOOTSTRAP_ADMIN_JSON.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# Nuvem: NODE_ENV=production, HOST=0.0.0.0 e TRUST_PROXY_HOPS=1 no Render.
# PUBLIC_ORIGIN deve ser uma origem HTTPS sem caminho. Se vazio, o servidor
# utiliza RENDER_EXTERNAL_URL do Render, também com validação HTTPS.
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0

# Cole a conexão privada do Postgres externo no painel do provedor.
# TLS e verificação de certificado são obrigatórios. DATA_DIR é ignorado no Postgres.
DATABASE_URL=

# Somente para banco vazio: JSON privado contendo name, email, algorithm=scrypt,
# salt hexadecimal de 32 bytes e hash hexadecimal de 64 bytes. Perfil sempre MASTER.
# Não informe uma senha em texto. O valor é ignorado se o banco já estiver iniciado.
BOOTSTRAP_ADMIN_JSON=
